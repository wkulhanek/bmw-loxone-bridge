# Required: Client ID from https://bmw-cardata.bmwgroup.com/customer
BMW_CLIENT_ID=your-client-id-uuid

# Required: 17-character Vehicle Identification Number
BMW_VIN=WBAXXXXXXXXXXXXXXX

# Optional: HTTP listen address (default: :8300)
#LISTEN_ADDR=:8300

# Optional: Data directory for session persistence (default: /data)
#DATA_DIR=/data

# Optional: Logging level — debug, info, warn, error (default: info)
#LOG_LEVEL=info

# Optional: REST API refresh interval in minutes when idle (default: 30)
# BMW allows 50 REST calls/day. 30 min = 48 calls/day (within limit).
#REFRESH_MINUTES=30

# Optional: REST API refresh interval in minutes while charging (default: 5)
# The bridge automatically detects charging and polls faster.
#ACTIVE_REFRESH_MINUTES=5
